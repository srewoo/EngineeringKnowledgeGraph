# =============================================================================
# EKG / CodeSage — environment configuration
# =============================================================================
# Copy this file to `.env` (already in .gitignore) and fill in real values.
#
# IMPORTANT — common pitfalls:
#  • Do NOT leave any value as the literal placeholder `...` — dotenv loads it
#    as the string "..." and the SDK will reject it on first API call. Either
#    set a real value or comment the whole line out.
#  • Inline comments (`KEY=val # comment`) work in dotenv@16+ ONLY when there
#    is whitespace before the `#`. Putting comments on their own line is safer.
#  • Tokens leak. Never commit `.env`. Rotate any token that ends up in a diff.
#
# Sections below correspond to the phases described in `llmPLAN.md` and
# `README.md`. Required vs optional is called out in each section header.

# =============================================================================
# CORE — required
# =============================================================================

# Neo4j connection. Defaults match `infra/docker-compose.yml`.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ekg-local-dev

# Local data directory (creates `<dir>/repos`, `<dir>/ekg.db`, `<dir>/ekg.log`,
# plus sibling DBs for embeddings/search).
DATA_DIR=./data

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# =============================================================================
# GIT ACCESS + BULK DISCOVERY — required for ingest_repo / bulk_ingest /
#                               discover_repos / gitlab_get_mr
# =============================================================================

# Personal access token. Scopes needed:
#   - read_repository (for clone)
#   - read_api        (for group/MR/pipeline discovery)
# NEVER commit this file with a real token.
GIT_TOKEN=

# Override for self-hosted GitLab. Leave default for gitlab.com.
GITLAB_URL=https://gitlab.com

# Comma-separated GitLab group IDs that bulk_ingest / discover_repos walk.
# Find them at https://gitlab.com/groups/<slug> → "Group ID" in the header.
GITLAB_GROUP_IDS=

# Hard size cap (MB). Repos bigger than this are skipped during bulk_ingest.
MAX_REPO_SIZE_MB=1024

# Per-repo ingestion timeout in ms. Min 60_000. Default 600_000 (10 min).
# Stuck clones/parses past this point are aborted and counted toward retries.
INGEST_TIMEOUT_MS=600000

# Bulk ingestion concurrency (1-32). Recommended: 5 for healthy laptops, 2
# if you see "transaction has been terminated" / Neo4j lock contention.
BULK_CONCURRENCY=5

# =============================================================================
# PHASE 2 — EMBEDDINGS (opt-in but recommended)
# Required for: search_semantic, hybrid/vector mode of search_codebase,
#               ask_question / answer_question semantic retrieval.
# =============================================================================

# Master switch.
EKG_EMBEDDINGS_ENABLED=true

# Provider: ollama | openai | voyage
EKG_EMBEDDING_PROVIDER=ollama

# Recommended models per provider:
#   ollama  → nomic-embed-text
#   openai  → text-embedding-3-small (1536 dims) or text-embedding-3-large (3072)
#   voyage  → voyage-code-2 (best for code) or voyage-3
EKG_EMBEDDING_MODEL=nomic-embed-text

# Optional dimension override (only some providers support it).
# EKG_EMBEDDING_DIMENSIONS=

# Ollama URL — only read when any *_PROVIDER=ollama. Default is the local
# install at http://localhost:11434. To use Ollama you must:
#   1. Install Ollama (`brew install ollama` or https://ollama.ai/download)
#   2. `ollama serve` (or run as a service)
#   3. `ollama pull nomic-embed-text` (~280 MB)
OLLAMA_URL=http://localhost:11434

# Cloud-provider keys — uncomment when switching EKG_EMBEDDING_PROVIDER.
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=

# =============================================================================
# PHASE 2.2 — RERANKER (optional; significant quality win on hybrid search)
# =============================================================================

# Provider: cohere | voyage | noop (default noop)
# EKG_RERANKER=cohere
# COHERE_API_KEY=
# (or use VOYAGE_API_KEY from above for voyage-rerank)

# =============================================================================
# PHASE 2.3 / PHASE 3 — ROUTER + AGENT
# Router LLM classifies the question and picks retrieval strategy.
# Agent LLM produces the final cited answer.
# =============================================================================

# Provider: openai | anthropic | ollama (default ollama)
EKG_ROUTER_PROVIDER=anthropic
EKG_AGENT_PROVIDER=anthropic

# Optional model overrides. Leave blank for the provider's default.
#   anthropic default: claude-sonnet-4-* (latest Sonnet)
#   openai     default: gpt-4o-mini for router, gpt-4o for agent
# EKG_ROUTER_MODEL=
# EKG_AGENT_MODEL=

# Hard switch for the agentic answer_question tool. Even with the provider
# set, answer_question will refuse unless this is "true".
# EKG_AGENT_ENABLED=true

# Provider keys (set the one matching the providers above).
# Don't leave as `...`.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# =============================================================================
# PHASE 4 — WEBHOOK SERVER (optional, push-driven incremental ingest)
# Only the apps/webhook-server process reads these. Run with:
#   node apps/webhook-server/dist/index.js
# Configure GitLab → Settings → Webhooks → Push events
#   URL:    http://<host>:8765/webhook/gitlab/push
#   Secret: same value as EKG_WEBHOOK_SECRET below (sent in X-Gitlab-Token).
# =============================================================================

# EKG_WEBHOOK_PORT=8765
# EKG_WEBHOOK_SECRET=replace-with-a-long-random-string-32+chars
# Comma-separated globs; empty/unset = accept any project. Glob syntax:
#   *  matches one path segment, **  matches across segments.
# EKG_WEBHOOK_REPO_PATTERNS=mindtickle/*,mindtickle/coaching/**
# EKG_WEBHOOK_MAX_CONCURRENT=5

# =============================================================================
# PHASE 6 — EXTERNAL MCP ADAPTERS
# Each adapter is enabled in `ekg.config.json` (`mcpAdapters[].enabled: true`).
# The env vars below supply the credentials referenced by `${VAR}` in that file.
# =============================================================================

# --- Datadog (REST adapter, no spawned MCP server) ---
# Required scopes: api_keys_read + service_account permissions for traces/logs.
# DD_API_KEY=
# DD_APP_KEY=
# DD_SITE=datadoghq.com   # us3.datadoghq.com / eu.datadoghq.com / ddog-gov.com

# --- Atlassian (Jira + Confluence) — wrapped stdio MCP server ---
# Spawns the upstream MCP server defined in ekg.config.json:
#   "command": "npx", "args": ["-y", "@aashari/mcp-server-atlassian-jira"]
# Pre-install: `npm install -g @aashari/mcp-server-atlassian-jira` (optional;
# `npx -y` will fetch on first call).
# Token: an Atlassian API token tied to your account
#   https://id.atlassian.com/manage-profile/security/api-tokens
# ATLASSIAN_TOKEN=
# ATLASSIAN_BASE_URL=https://yourorg.atlassian.net
# ATLASSIAN_EMAIL=you@yourorg.com

# --- Mixpanel — wrapped stdio MCP server ---
# MIXPANEL_TOKEN=
# MIXPANEL_PROJECT_ID=

# --- Loki / Grafana — wrapped stdio or direct HTTP ---
# LOKI_URL=https://loki.internal.yourorg.com
# LOKI_USER=                     # if behind basic auth
# LOKI_PASSWORD=

# =============================================================================
# OPTIONAL TUNING / TROUBLESHOOTING KNOBS
# =============================================================================

# Override the ts-morph parser pool size. Default = (cpus - 1).
# EKG_PARSER_POOL_SIZE=4

# Disable the file logger (stays on stderr only). Useful in CI.
# EKG_DISABLE_FILE_LOG=true

# Skip the post-ingest embeddings pass even when EKG_EMBEDDINGS_ENABLED=true.
# Useful when bringing up Ollama for the first time and you don't want
# embeddings to silently retry.
# EKG_SKIP_EMBEDDINGS_PASS=true

# Set to "true" to fail loudly when a repo's content_hash hasn't changed but
# we'd otherwise re-ingest. Default behaviour is to skip silently.
# EKG_STRICT_SHA_SKIP=true
